# Required core settings. MASTER_KEY must decode to exactly 32 bytes.
# Generate: uv run python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SONG_AGENT_MASTER_KEY=
SONG_AGENT_DATABASE_PATH=.data/song-agent-v1.db
SONG_AGENT_ENABLED_MODULES=conversation,memory,agent,plan,delivery,system
SONG_AGENT_EXTERNAL_PLUGINS_ENABLED=false
SONG_AGENT_EXTERNAL_PLUGIN_ALLOWLIST=
SONG_AGENT_MAX_EXECUTION_TIMEOUT_SECONDS=180
SONG_AGENT_CONFIRM_ALL_WRITES=false
SONG_AGENT_LOG_LEVEL=INFO
SONG_AGENT_PORT=45837
# Public origin used to build OAuth callbacks; do not include a trailing slash.
SONG_AGENT_PUBLIC_BASE_URL=http://127.0.0.1:45837

# OpenAI-compatible inbound API authentication.
SONG_AGENT_API_KEY=
SONG_AGENT_API_KEY_NAME=default
SONG_AGENT_API_DEFAULT_TENANT=default
SONG_AGENT_API_PRINCIPAL_ID=api-client
SONG_AGENT_API_MODEL_ID=song-agent-v1
SONG_AGENT_API_RATE_LIMIT_PER_MINUTE=60
SONG_AGENT_API_MAX_MESSAGES=100
SONG_AGENT_API_MAX_TOTAL_CHARS=200000

# LLM provider used independently as IntentModel, ConversationModel and AgentModel.
LLM_BASE_URL=https://example.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=1

# Feishu webhook channel adapter. The callback is /adapters/feishu/events.
FEISHU_CHANNEL_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOMAIN=https://open.feishu.cn
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_GRANTED_PERMISSIONS=calendar.read,calendar.write,task.read,task.write,document.read,document.write

# Feishu workspace provider. Credentials are acquired per principal by OAuth and encrypted.
# Enable calendar/task/reminder/document modules only when this is configured.
FEISHU_WORKSPACE_ENABLED=false
FEISHU_CALENDAR_ID=

# Trusted attachment ingress storage. Understanding remains in attachment.* providers/handlers.
SONG_AGENT_ATTACHMENT_DIRECTORY=.data/attachments-v1
SONG_AGENT_ATTACHMENT_MAX_BYTES=157286400
SONG_AGENT_ATTACHMENT_TTL_SECONDS=2592000
SONG_AGENT_ATTACHMENT_VISION_BASE_URL=
SONG_AGENT_ATTACHMENT_VISION_API_KEY=
SONG_AGENT_ATTACHMENT_VISION_MODEL=
SONG_AGENT_ATTACHMENT_ASR_URL=
SONG_AGENT_ATTACHMENT_DOCUMENT_PARSER_URL=

SONG_AGENT_SEARCH_ENABLED=false
SONG_AGENT_SEARCH_PROVIDER=tavily
SONG_AGENT_SEARCH_TAVILY_API_KEY=
SONG_AGENT_SEARCH_TAVILY_ENDPOINT=https://api.tavily.com/search

SONG_AGENT_SCHEDULER_LEASE_SECONDS=30
