# 飞书自建应用配置
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx
FEISHU_DOMAIN=https://open.feishu.cn
# 群内无需 @ 接收文字和图片，应用还需开通敏感权限 im:message.group_msg，
# 发布新版本并由企业管理员审批。

# 兼容旧部署；新群不再要求管理员首次绑定
FEISHU_ADMIN_USER_IDS=ou_xxxxxxxxxxxxxxxx
# 启动时预登记的群聊 ID；机器人进入其他群并首次收到 @ 消息后会自动登记
FEISHU_ALLOWED_GROUP_CHAT_IDS=
# 指定日历 ID，留空则使用用户主日历
FEISHU_CALENDAR_ID=
# 飞书 MCP CLI 路径，留空则使用 npx 自动下载
FEISHU_MCP_CLI=
# 飞书卡片回调验签配置；未配置时敏感操作回调接口拒绝服务
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# URL-safe base64 encoded 32-byte AES key. Generate with:
# uv run python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
SONG_AGENT_TOKEN_KEY_V1=
SONG_AGENT_TOKEN_ACTIVE_KEY_VERSION=1

# 公网访问地址，开发环境使用 ngrok 内网穿透
PUBLIC_BASE_URL=http://0.0.0.0:45837
PORT=45837
TIMEZONE=Asia/Shanghai

# LLM 配置（OpenAI 兼容接口）
LLM_BASE_URL=https://example.com/v1
LLM_API_KEY=
LLM_MODEL=glm-5

# 外部 OpenAI 兼容 API（当前仅支持文本）
SONG_AGENT_API_ENABLED=false
SONG_AGENT_API_MODEL_ID=song-agent-2.1
SONG_AGENT_API_KEY_NAME=default
SONG_AGENT_API_KEY=
SONG_AGENT_API_DEFAULT_TENANT=default
SONG_AGENT_API_APP_ID=song-agent-api

# 飞书附件（外部 /api/v1 仍仅支持文本）
SONG_AGENT_ATTACHMENTS_ENABLED=true
SONG_AGENT_ATTACHMENT_DIR=/var/lib/song-agent/attachments
SONG_AGENT_ATTACHMENT_TEMP_DIR=/var/lib/song-agent/tmp
SONG_AGENT_ATTACHMENT_TTL_SECONDS=2592000
SONG_AGENT_ATTACHMENT_MAX_FILES_PER_MESSAGE=5
SONG_AGENT_ATTACHMENT_MAX_TOTAL_MB_PER_MESSAGE=150
SONG_AGENT_ATTACHMENT_DOWNLOAD_TIMEOUT_SECONDS=90

# Kimi 图片理解
SONG_AGENT_VISION_ENABLED=true
SONG_AGENT_VISION_BASE_URL=https://api.moonshot.cn/v1
SONG_AGENT_VISION_API_KEY=
SONG_AGENT_VISION_MODEL=kimi-k2.6
SONG_AGENT_VISION_CONNECT_TIMEOUT_SECONDS=10
SONG_AGENT_VISION_READ_TIMEOUT_SECONDS=45
SONG_AGENT_VISION_MAX_RETRIES=0
SONG_AGENT_VISION_MAX_TOKENS=1600
SONG_AGENT_VISION_THINKING_ENABLED=false
SONG_AGENT_VISION_MAX_IMAGE_MB=20
SONG_AGENT_VISION_MAX_IMAGES_PER_MESSAGE=4

# 语音识别
SONG_AGENT_ASR_ENABLED=true
SONG_AGENT_ASR_BASE_URL=http://183.147.142.111:25570
SONG_AGENT_ASR_PATH=/api/v1/asr
SONG_AGENT_ASR_DEFAULT_LANGUAGE=auto
SONG_AGENT_ASR_CONNECT_TIMEOUT_SECONDS=10
SONG_AGENT_ASR_READ_TIMEOUT_SECONDS=300
SONG_AGENT_ASR_MAX_AUDIO_MB=100

# 公司 MinerU VL（OpenAI 兼容接口）
SONG_AGENT_DOCUMENT_PARSER_ENABLED=true
SONG_AGENT_DOCUMENT_PARSER_PROVIDER=mineru_vl
SONG_AGENT_DOCUMENT_PARSE_TIMEOUT_SECONDS=300
SONG_AGENT_DOCUMENT_MAX_FILE_MB=50
SONG_AGENT_DOCUMENT_MAX_CONTEXT_CHARS=4000
SONG_AGENT_DOCUMENT_MAX_PREVIEW_CHARS=2000
SONG_AGENT_MINERU_VL_BASE_URL=http://183.147.142.111:63359/v1
SONG_AGENT_MINERU_VL_MODEL_NAME=
SONG_AGENT_MINERU_VL_SERVER_HEADERS={}
SONG_AGENT_MINERU_VL_CONNECT_TIMEOUT_SECONDS=10
SONG_AGENT_MINERU_VL_READ_TIMEOUT_SECONDS=300
SONG_AGENT_MINERU_VL_PDF_SCALE=2.0
SONG_AGENT_MINERU_VL_MAX_PAGES=100
SONG_AGENT_MINERU_VL_PAGE_CONCURRENCY=2
SONG_AGENT_MINERU_VL_REGION_CONCURRENCY=4
SONG_AGENT_MINERU_VL_MAX_RETRIES=1

# 定时任务（cron 格式）
MORNING_CRON=45 10 * * *
EVENING_CRON=30 23 * * *
SCHEDULER_POLL_SECONDS=15

# SQLite 状态库；生产环境启用 WAL，支持多连接并发
DATABASE_PATH=.data/song-agent.db
# 旧版 JSON 状态文件，仅用于首次迁移；迁移后不再写入
DATA_FILE=.data/state.json
PROCESSED_EVENT_RETENTION_DAYS=30
PENDING_ACTION_TTL_SECONDS=1800
MAX_AGENT_STEPS=12
MAX_TOOL_CALLS_PER_RUN=8
MAX_CONSECUTIVE_TOOL_ERRORS=2
AGENT_RUN_TIMEOUT_SECONDS=90
LOG_LEVEL=INFO
